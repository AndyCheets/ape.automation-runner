{
  "name": "Ape Automation Runner DevContainer",
  "dockerComposeFile": "docker-compose.yml",
  "service": "automation-runner-devcontainer",
  "workspaceFolder": "/workspace/ape.automation-runner",
  "remoteUser": "vscode",
  "updateRemoteUserUID": true,
  "forwardPorts": [8081, 5672, 15672],
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-dotnettools.csharp",
        "ms-dotnettools.csdevkit",
        "editorconfig.editorconfig",
        "redhat.vscode-yaml",
        "ms-azuretools.vscode-docker",
        "openai.chatgpt"
      ]
    }
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh"
}
